
# ---- Ring door intercom (door path; unset => disabled) ----
RING_REFRESH_TOKEN=
RING_INTERCOM_DEVICE_ID=

# ---- Weg B: server-enforced door gate (laika appointment-gate) ----
# laika's gate-check endpoint. Unset => open_door is NOT gated (legacy).
LAIKA_GATE_URL=http://127.0.0.1:8000/api/v1/gate-check
# off = no gate | advisory = log decision but still open | enforce = open only if authorized
DOOR_GATE_MODE=advisory
