# ---- Orchestrator ----
PORT=8787
LOG_LEVEL=info

# ---- ElevenLabs ----
# One key for both STT (Scribe v2 Realtime) and TTS (streaming).
ELEVENLABS_API_KEY=
# ElevenLabs Agent (Conversational AI) — the full voice loop. Public agent = id is enough.
ELEVENLABS_AGENT_ID=
# TTS voice for Nera (used by the fallback pipeline, not the agent path).
ELEVENLABS_TTS_VOICE_ID=
# Low-latency TTS model. flash = fastest.
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
# Realtime STT model id.
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
# VAD endpointing (tune live for the room):
# Trailing silence (ms) before end-of-turn commit. Higher = won't cut you off mid-sentence.
STT_COMMIT_SILENCE_MS=800
# Voice-activity sensitivity 0..1. Higher = needs clearer speech (fewer false triggers on noise).
STT_VAD_THRESHOLD=0.5
# Ignore speech bursts shorter than this (ms) — kills clicks/blips.
STT_MIN_SPEECH_MS=300

# ---- OpenRouter (agent) ----
OPENROUTER_API_KEY=
# Fast tool-calling model. Swap to native provider if TTFT disappoints.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Go2 robot sink (optional; unset => dry-run, no robot needed) ----
GO2_FOXGLOVE_URL=

# ---- Yodeck (optional) ----
YODECK_API_TOKEN=

# ---- Ring door intercom (optional; unset => door audio source disabled) ----
# The door is unlocked by the agent's open_door tool -> DoorIntercom.unlock().
# Refresh token for the Ring account that OWNS the intercom. Generate with the
# patched ring-client-api fork's CLI:  ./packages/ring-client-api/lib/ring-auth-cli.js
# Rotates on use — persist the new value via DoorIntercom's onRefreshToken.
RING_REFRESH_TOKEN=
# Optional: pin a specific intercom by device id (defaults to the first found).
RING_INTERCOM_DEVICE_ID=
